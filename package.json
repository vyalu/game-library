{
  "name": "game-library",
  "version": "1.16.4",
  "description": "Game Library — локальная библиотека игр для Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node tests/check.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.gamelibrary.app",
    "productName": "Game Library",
    "copyright": "Game Library",
    "artifactName": "Game-Library-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "download.js",
      "enricher.js",
      "hltb.js",
      "ai.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "game-library",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Game Library",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Game Library"
  }
}
